{
    "$schema": "https://www.schemastore.org/template.json",
    "author": "sadicangel",
    "identity": "SadicAngel.Templates.Library",
    "name": "Library Template",
    "shortName": "sa-lib",
    "classifications": [
        "library",
        "project"
    ],
    "tags": {
        "type": "solution",
        "language": "C#"
    },
    "sourceName": "Solution0",
    "symbols": {
        "library": {
            "type": "derived",
            "datatype": "string",
            "valueSource": "name",
            "valueTransform": "namespace",
            "replaces": "Library0",
            "fileRename": "Library0"
        }
    },
    "forms": {
        "alphanum": {
            "identifier": "replace",
            "pattern": "[^a-zA-Z0-9]",
            "replacement": ""
        },
        "removeDashes": {
            "identifier": "replace",
            "pattern": "-",
            "replacement": ""
        },
        "namespace": {
            "identifier": "chain",
            "steps": [
                "alphanum",
                "kebabCase",
                "titleCase",
                "removeDashes"
            ]
        }
    },
    "sources": [
        {
            "source": "./",
            "target": "./",
            "modifiers": [
                {
                    "rename": {
                        "github": ".github"
                    }
                }
            ]
        }
    ]
}